{
  "name": "trick",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
