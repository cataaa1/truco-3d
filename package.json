{
  "name": "truco-online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "models": "node scripts/blender/run.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cards": "node scripts/build-cards.mjs",
    "voices": "node scripts/build-voices.mjs",
    "ambiente": "node scripts/build-ambiente.mjs",
    "materials": "node scripts/build-materials.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@fontsource/rye": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
